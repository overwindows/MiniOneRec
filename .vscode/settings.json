        "/^cd C:\\\\Users\\\\wuc\\\\MiniOneRec; python -c \"\nfrom transformers import AutoTokenizer\nimport os, statistics\n\ntokenizer = AutoTokenizer\\.from_pretrained\\('Qwen/Qwen3-1\\.7B', trust_remote_code=True\\)\n\n# Load news from local MIND data\nnews_path = 'data/Amazon/MIND_large_dev_news\\.tsv'\n# Try multiple possible paths\nfor p in \\['data/MIND_large/dev/news\\.tsv', 'data/MIND_small/dev/news\\.tsv', 'data/MIND/dev/news\\.tsv'\\]:\n    if os\\.path\\.exists\\(p\\):\n        news_path = p\n        break\n\nif not os\\.path\\.exists\\(news_path\\):\n    # Try to find any news\\.tsv\n    import glob\n    found = glob\\.glob\\('\\*\\*/news\\.tsv', recursive=True\\)\n    print\\(f'Found news files: \\{found\\[:5\\]\\}'\\)\n    if found:\n        news_path = found\\[0\\]\n    else:\n        print\\('No news\\.tsv found locally'\\)\n        exit\\(\\)\n\nprint\\(f'Using: \\{news_path\\}'\\)\n\n# Measure title and abstract token lengths\ntitle_lens = \\[\\]\nabstract_lens = \\[\\]\ntitle_abstract_lens = \\[\\]\n\nwith open\\(news_path, 'r', encoding='utf-8'\\) as f:\n    for i, line in enumerate\\(f\\):\n        parts = line\\.strip\\(\\)\\.split\\('\\\\t'\\)\n        if len\\(parts\\) < 4:\n            continue\n        title = parts\\[3\\]\n        abstract = parts\\[4\\] if len\\(parts\\) > 4 else ''\n        category = parts\\[1\\] if len\\(parts\\) > 1 else ''\n        \n        # Simulate prompt format: '\\{i\\}\\. \\[\\{cat\\}\\] \\{text\\}\\\\n'\n        title_entry = f'1\\. \\[\\{category\\}\\] \\{title\\}\\\\n'\n        abstract_entry = f'1\\. \\[\\{category\\}\\] \\{title\\} \\{abstract\\}\\\\n' if abstract else title_entry\n        \n        t_tokens = len\\(tokenizer\\.encode\\(title_entry, add_special_tokens=False\\)\\)\n        a_tokens = len\\(tokenizer\\.encode\\(abstract_entry, add_special_tokens=False\\)\\)\n        \n        title_lens\\.append\\(t_tokens\\)\n        if abstract:\n            abstract_lens\\.append\\(a_tokens\\)\n            title_abstract_lens\\.append\\(a_tokens\\)\n        else:\n            title_abstract_lens\\.append\\(t_tokens\\)\n\nprint\\(f'\\\\nNews articles: \\{len\\(title_lens\\)\\}'\\)\nprint\\(f'\\\\n--- Title-only per article ---'\\)\nprint\\(f'  Mean: \\{statistics\\.mean\\(title_lens\\):\\.1f\\} tokens'\\)\nprint\\(f'  Median: \\{statistics\\.median\\(title_lens\\):\\.0f\\} tokens'\\)\nprint\\(f'  P95: \\{sorted\\(title_lens\\)\\[int\\(len\\(title_lens\\)\\*0\\.95\\)\\]:\\.0f\\} tokens'\\)\nprint\\(f'  Max: \\{max\\(title_lens\\)\\} tokens'\\)\n\nprint\\(f'\\\\n--- Title\\+Abstract per article \\(when abstract exists\\) ---'\\)\nprint\\(f'  Count with abstract: \\{len\\(abstract_lens\\)\\}/\\{len\\(title_lens\\)\\}'\\)\nif abstract_lens:\n    print\\(f'  Mean: \\{statistics\\.mean\\(abstract_lens\\):\\.1f\\} tokens'\\)\n    print\\(f'  Median: \\{statistics\\.median\\(abstract_lens\\):\\.0f\\} tokens'\\)\n    print\\(f'  P95: \\{sorted\\(abstract_lens\\)\\[int\\(len\\(abstract_lens\\)\\*0\\.95\\)\\]:\\.0f\\} tokens'\\)\n    print\\(f'  Max: \\{max\\(abstract_lens\\)\\} tokens'\\)\n\n# Estimate full prompt sizes\n# system prompt \\+ chat template overhead ~ 80 tokens\n# 'A user read these news articles:\\\\n' ~ 8 tokens\n# 'Candidate article:\\\\n\\[cat\\] title abstract\\\\n\\\\nWill this user\\.\\.\\.Answer:' ~ 30 \\+ candidate tokens\n# target ' Yes'/' No' ~ 2 tokens\noverhead = 120  # system prompt \\+ chat template \\+ question \\+ target\n\nfor hist_count in \\[30, 50\\]:\n    for use_abstract in \\[False, True\\]:\n        lens = title_abstract_lens if use_abstract else title_lens\n        avg = statistics\\.mean\\(lens\\)\n        p95 = sorted\\(lens\\)\\[int\\(len\\(lens\\)\\*0\\.95\\)\\]\n        \n        avg_total = overhead \\+ avg \\* \\(hist_count \\+ 1\\)\n        p95_total = overhead \\+ p95 \\* \\(hist_count \\+ 1\\)\n        worst_total = overhead \\+ max\\(lens\\) \\* \\(hist_count \\+ 1\\)\n        \n        label = 'abstract' if use_abstract else 'title-only'\n        print\\(f'\\\\n--- \\{hist_count\\} history \\+ 1 candidate \\(\\{label\\}\\) ---'\\)\n        print\\(f'  Avg prompt:  \\{avg_total:\\.0f\\} tokens'\\)\n        print\\(f'  P95 prompt:  \\{p95_total:\\.0f\\} tokens'\\)\n        print\\(f'  Worst case:  \\{worst_total:\\.0f\\} tokens'\\)\n        for cutoff in \\[2048, 4096, 8192\\]:\n            truncated_avg = \\(avg_total > cutoff\\)\n            truncated_p95 = \\(p95_total > cutoff\\)\n            pct_over = sum\\(1 for l in lens for _ in range\\(1\\) if overhead \\+ l \\* \\(hist_count\\+1\\) > cutoff\\) / len\\(lens\\) \\* 100\n            print\\(f'  cutoff=\\{cutoff\\}: avg \\{\\\\\"TRUNCATED\\\\\" if truncated_avg else \\\\\"OK\\\\\"\\}, p95 \\{\\\\\"TRUNCATED\\\\\" if truncated_p95 else \\\\\"OK\\\\\"\\}, ~\\{pct_over:\\.1f\\}% samples truncated'\\)\n\"\n$/": {
