{
  "pipeline_name": "Frozen JEV residual readout probe",
  "commands": [
    {
      "name": "Clone source",
      "command": "git clone https://github.com/overwindows/MiniOneRec.git {code_dir}/MiniOneRec",
      "working_dir": "{code_dir}"
    },
    {
      "name": "Checkout exact source revision",
      "command": "git fetch {code_dir}/source.bundle HEAD && git checkout --detach {source_revision} && git rev-parse HEAD",
      "working_dir": "{code_dir}/MiniOneRec"
    },
    {
      "name": "Prepare environment",
      "command": "bash scripts/setup_multi_node.sh",
      "working_dir": "{code_dir}/MiniOneRec"
    },
    {
      "name": "Run bounded frozen readout probe",
      "command": "CUDA_VISIBLE_DEVICES=0 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True /home/aiscuser/.conda/envs/MiniOneRec/bin/python -u src/probe_jev_readout.py --model-path {model_path} --data-root {data_root} --output {output_root} --source-revision {source_revision} --train-pairs 16384 --validation-impressions 256 --dev-start 5000 --dev-impressions 1000",
      "working_dir": "{code_dir}/MiniOneRec"
    }
  ],
  "error_handling": {
    "stop_on_error": true,
    "retry_failed_commands": false,
    "max_retries": 1
  },
  "logging": {
    "log_level": "INFO",
    "save_command_outputs": true
  }
}
